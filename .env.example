# Denta environment configuration - template.
#
# The app reads one of two files, chosen when it is built:
#   .env.dev   - the dev/test server (default: make run, flutter run, *-dev targets)
#   .env.prod  - the live server     (make build-apk / build-ios / build-windows, run-prod)
# The choice is --dart-define=APP_ENV=prod (anything else means dev); see
# AppConfig.appEnv. Both files are bundled into every build.

BASE_URL=https://example.com/api
API_TIMEOUT=30
# development | production
ENVIRONMENT=development
