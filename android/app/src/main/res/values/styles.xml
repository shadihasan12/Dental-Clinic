<?xml version="1.0" encoding="utf-8"?>
<!--
    Unqualified on purpose. Everything that changes between light and dark is a
    resource reference resolved per-mode in values/splash.xml vs
    values-night/splash.xml, so there is no second copy of these styles to fall
    out of sync. A values-night styles.xml is what previously pinned the splash
    to Theme.Black and painted it black in front of a light app.

    The parent theme is only a carrier here - every attribute the splash window
    actually shows is set explicitly below.
-->
<resources>
    <!-- Theme applied to the Android Window while the process is starting. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame. Android 12+ overrides
             this with the system splash screen - see values-v31. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">@bool/splash_light_status_bar</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowLightStatusBar">@bool/splash_light_status_bar</item>
    </style>
</resources>
